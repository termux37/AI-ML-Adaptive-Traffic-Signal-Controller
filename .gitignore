# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches and temporary directories
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Streamlit
.streamlit/secrets.toml

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Large model downloads (Ultralytics auto-downloads yolov8n.pt on first run)
*.pt

# Ephemeral simulation runs and generated routes during training
data/runs/*.log
data/runs/rl_ep_*.csv
data/runs/rl_ep_*.json
simulation/routes/rl_ep_*.rou.xml
simulation/routes/realtime_*.rou.xml

# Keep structure of artifact and data directories
!artifacts/models/.gitkeep
!artifacts/videos/.gitkeep
!artifacts/reports/.gitkeep
!data/runs/.gitkeep
!data/processed/.gitkeep
