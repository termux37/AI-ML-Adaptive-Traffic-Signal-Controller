    <inductionLoop id="det_stop_w_0" lane="edge_w2c_0" pos="230.0" freq="1" file="NUL"/>
    <inductionLoop id="det_stop_w_1" lane="edge_w2c_1" pos="230.0" freq="1" file="NUL"/>

