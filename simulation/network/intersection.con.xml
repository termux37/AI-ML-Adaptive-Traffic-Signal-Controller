<?xml version="1.0" encoding="UTF-8"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- North incoming (edge_n2c) -->
    <connection from="edge_n2c" to="edge_c2w" fromLane="0" toLane="0"/>
    <connection from="edge_n2c" to="edge_c2s" fromLane="0" toLane="0"/>
    <connection from="edge_n2c" to="edge_c2s" fromLane="1" toLane="1"/>
    <connection from="edge_n2c" to="edge_c2e" fromLane="1" toLane="1"/>

    <!-- South incoming (edge_s2c) -->
    <connection from="edge_s2c" to="edge_c2e" fromLane="0" toLane="0"/>
    <connection from="edge_s2c" to="edge_c2n" fromLane="0" toLane="0"/>
    <connection from="edge_s2c" to="edge_c2n" fromLane="1" toLane="1"/>
    <connection from="edge_s2c" to="edge_c2w" fromLane="1" toLane="1"/>

    <!-- East incoming (edge_e2c) -->
    <connection from="edge_e2c" to="edge_c2n" fromLane="0" toLane="0"/>
    <connection from="edge_e2c" to="edge_c2w" fromLane="0" toLane="0"/>
    <connection from="edge_e2c" to="edge_c2w" fromLane="1" toLane="1"/>
    <connection from="edge_e2c" to="edge_c2s" fromLane="1" toLane="1"/>

    <!-- West incoming (edge_w2c) -->
    <connection from="edge_w2c" to="edge_c2s" fromLane="0" toLane="0"/>
    <connection from="edge_w2c" to="edge_c2e" fromLane="0" toLane="0"/>
    <connection from="edge_w2c" to="edge_c2e" fromLane="1" toLane="1"/>
    <connection from="edge_w2c" to="edge_c2n" fromLane="1" toLane="1"/>
</connections>
